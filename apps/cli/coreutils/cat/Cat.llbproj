' Project Name: PROS CoreUtils - cat
' Filename: apps/cli/coreutils/cat/Cat.llbproj
' Summary: Standalone Ring 3 concatenate and print file utility.

[Project]
Name    = "cat"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "cat.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../../../lib/runtime/brt0.S"
Assembly = "../../../../lib/runtime/mem.S"
Module   = "CatMain.bas"

