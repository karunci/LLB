' Project Name: PROS CoreUtils - uptime
' Filename: apps/cli/coreutils/uptime/Uptime.llbproj
' Summary: Standalone Ring 3 system elapsed uptime utility.

[Project]
Name    = "uptime"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "uptime.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../../../lib/runtime/brt0.S"
Assembly = "../../../../lib/runtime/mem.S"
Module   = "UptimeMain.bas"

