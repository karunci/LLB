' Project Name: Low-Level Basic TypeAlias Test Suite
' Filename: tests/type_alias_test/TypeAliasTest.llbproj
' Summary: Verification test manifest exercising cross-import TypeAlias propagation and modernized enums.

[Project]
Name    = "test_type_alias"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "test_type_alias.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../lib/runtime/brt0.S"
Assembly = "../../lib/runtime/mem.S"
Module   = "src/TypeAliasMain.bas"
