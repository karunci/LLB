' Project Name: Low-Level Basic Standard Library Test Suite
' Filename: tests/stdlib/TestStdlib.llbproj
' Summary: Standalone Ring 3 verification test suite exercising all 22 pure LLB standard library routines.

[Project]
Name    = "test_stdlib"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "test_stdlib.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../lib/runtime/brt0.S"
Assembly = "../../lib/runtime/mem.S"
Module   = "src/TestStdlibMain.bas"

