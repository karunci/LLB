' Project Name: Low-Level Basic / Userland Test Suite
' Filename: tests/userland/TestSuite.llbproj
' Summary: Project manifest for the comprehensive LLB runtime test suite.
'          Compiles all helper modules, class fixtures, and the main test
'          runner into a single native ELF executable. Run after any
'          compiler or runtime change to validate correctness.

[Project]
Name    = "TestSuite"
Type    = "Executable"
Version = "1.0.0"

; [Target] is intentionally omitted for hosted Executables.
; The compiler uses the host's native triple (aarch64 on Termux, x86_64 on x86_64 Linux)
; so the output links correctly against the host CRT.
; For bare-metal/cross targets, uncomment and fill in:
;   [Target]
;   Arch   = "x86_64-unknown-none-elf"

[Output]
; All build artifacts are placed in the project-local build/ sub-directory
; to avoid cluttering the source tree.
OutDir  = "build"
OutFile = "testsuite"

[Entry]
EntryPoint = "TestSuite.RunAllTests"

[Sources]
; --- Shared library stub (must be compiled as a shared .so before linking) ---
Module = "SharedLib.bas"

; --- Static helper module ---
Module = "StaticMath.bas"

; --- Namespace / import helpers ---
Module = "NamespaceHelper.bas"
Module = "ImportHelper.bas"

; --- Class fixtures ---
Class = "ClassHelper.cls"
Class = "SingleUseHelper.cls"
Class = "DeviceWriter.cls"
Class = "NestedNamespaceX.cls"
Class = "NestedNamespaceY.cls"

; --- Main test runner ---
Module = "TestSuite.bas"

[CompilerOptions]
Optimize            = "O0"
EmitDebugSymbols    = True
AllowUnsafePointers = True

; [Script] section omitted to avoid redundant script execution during automated testing.
; Post-build CLI and Rejection test suites are independently managed and orchestrated
; by CTest (Test #3: CliOptions and Test #4: Rejections) or can be executed directly via:
;   bash tests/userland/test_cli_options.sh
;   bash tests/userland/test_rejections.sh
