' Project Name: PROS 3D GL Demo
' Filename: apps/gui/gl_demo/GlDemo.llbproj
' Summary: Standalone Ring 3 Software 3D OpenGL Rasterizer interactive demo.

[Project]
Name    = "GlDemo"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "gl_demo.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../../lib/runtime/brt0.S"
Assembly = "../../../lib/runtime/mem.S"
Module   = "GlDemoMain.bas"
