' Project Name: PROS Window Manager Service
' Filename: services/wm/WmService.llbproj
' Summary: Standalone Ring 3 window manager service daemon.

[Project]
Name    = "WmService"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "wm.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "brt0.S"
Module   = "WmMain.bas"
