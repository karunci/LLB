' Project Name: Low-Level Basic Empirical Challenge ABI Test Suite
' Filename: tests/challenge_abi_test/ChallengeAbiTest.llbproj
' Summary: Verification test manifest exercising adversarial stress cases on TypeAlias, Enums, and String ABI.

[Project]
Name    = "test_challenge_abi"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "test_challenge_abi.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../lib/runtime/brt0.S"
Assembly = "../../lib/runtime/mem.S"
Module   = "src/ChallengeMain.bas"
