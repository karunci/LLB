' Project Name: PROS Display Driver Service
' Filename: services/disp_srv/DispService.llbproj
' Summary: Standalone Ring 3 display driver service daemon.

[Project]
Name    = "DispService"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "disp_srv.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "brt0.S"
Module   = "DispMain.bas"
