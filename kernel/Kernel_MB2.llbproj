' Project Name: PRK (Personal Research Kernel) / Low-Level Basic (LLB)
' Filename: kernel/Kernel_MB2.llbproj
' Summary: Bare-metal x86_64 PRK kernel build descriptor for Multiboot 2 (Native UEFI GOP).

[Project]
Name    = "PRK-Kernel-MB2"
Type    = "Kernel"
Version = "0.1.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "kernel_mb2.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "linker.ld"
Libraries    = [
    "../lib/metal/build/libllb_metal.a"
]

[Sources]
Assembly = "src/arch/x86_64/boot_mb2.S"
Assembly = "src/arch/x86_64/IsrStubs.S"
Assembly = "src/arch/x86_64/SwitchContext.S"
Assembly = "src/arch/x86_64/SyscallEntry.S"
Assembly = "src/drivers/Font8x16_data.S"
Class    = "src/fs/TarArchive.cls"
Module   = "src/exec/BaxTypes.bas"
Class    = "src/exec/BaxLoader.cls"
Module   = "src/arch/x86_64/PortIO.bas"
Module   = "src/arch/x86_64/GdtTypes.bas"
Module   = "src/arch/x86_64/Gdt.bas"
Module   = "src/arch/x86_64/Apic.bas"
Module   = "src/arch/x86_64/IoApic.bas"
Module   = "src/arch/x86_64/Idt.bas"
Module   = "src/arch/x86_64/Acpi.bas"
Module   = "src/sync/Spinlock.bas"
Class    = "src/arch/x86_64/CpuContext.cls"
Class    = "src/drivers/ICharDevice.cls"
Class    = "src/drivers/SerialUart.cls"
Class    = "src/drivers/Keyboard.cls"
Class    = "src/drivers/Mouse.cls"
Class    = "src/drivers/Terminal.cls"
Module   = "src/drivers/Font8x16.bas"
Class    = "src/drivers/Framebuffer.cls"
Module   = "src/node/NodeTypes.bas"
Class    = "src/node/SynapseChannel.cls"
Class    = "src/node/NodeRegistry.cls"
Class    = "src/mem/PhysicalMemoryManager.cls"
Class    = "src/mem/BuddyAllocator.cls"
Class    = "src/mem/VirtualMemoryManager.cls"
Class    = "src/mem/KernelHeap.cls"
Class    = "src/mem/SharedMemoryManager.cls"
Class    = "src/arch/power/PowerManager.cls"
Module   = "src/arch/x86_64/Smp.bas"
Class    = "src/sys/HardwareInfo.cls"
Module   = "src/sched/TaskTypes.bas"
Class    = "src/sched/TaskControlBlock.cls"
Class    = "src/sched/Scheduler.cls"
Module   = "src/sys/Syscall.bas"
Module   = "../lib/metal/tests/TestMetal.bas"
Module   = "src/KernelMain.bas"
