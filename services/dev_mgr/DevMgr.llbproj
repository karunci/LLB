' Project Name: PROS Device Manager Service
' Filename: services/dev_mgr/DevMgr.llbproj
' Summary: Standalone Ring 3 device manager service daemon.

[Project]
Name    = "DevMgrService"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "dev_mgr.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "brt0.S"
Module   = "DevMgrMain.bas"
