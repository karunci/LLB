' Project Name: PROS Plexus Service Supervisor
' Filename: services/plexus_mgr/PlexusMgr.llbproj
' Summary: Standalone Ring 3 service manager supervisor daemon.

[Project]
Name    = "PlexusMgrService"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "plexus_mgr.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "brt0.S"
Module   = "PlexusMgrMain.bas"
