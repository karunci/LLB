' Project Name: Low-Level Basic Empirical Stress Widening Test
' Filename: tests/stress_widening/StressWidening.llbproj
' Summary: Stress tests for implicit integer widening, mixed signed/unsigned comparisons,
'          screen clipping scenarios, and concise cast expressions.

[Project]
Name    = "StressWidening"
Type    = "Executable"
Version = "1.0.0"

[Output]
OutDir  = "build"
OutFile = "stress_widening"

[Entry]
EntryPoint = "StressWidening.Main"

[Sources]
Module = "StressWidening.bas"

[CompilerOptions]
Optimize            = "O0"
EmitDebugSymbols    = True
AllowUnsafePointers = True
