' Project Name: Low-Level Basic M2 Empirical Stress Test Suite
' Filename: tests/m2_empirical_test/M2EmpiricalTest.llbproj
' Summary: Verification test manifest exercising Compositor, WM, and Display interactions for Milestone 2.

[Project]
Name    = "test_m2_empirical"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "test_m2_empirical.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../lib/runtime/brt0.S"
Assembly = "../../lib/runtime/mem.S"
Assembly = "../../lib/runtime/fast_blit32.S"
Module   = "src/M2EmpiricalMain.bas"
