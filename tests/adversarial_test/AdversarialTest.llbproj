' Project Name: Low-Level Basic Adversarial Stress Test Suite
' Filename: tests/adversarial_test/AdversarialTest.llbproj
' Summary: Adversarial test suite exercising TypeAlias chaining, pointers, arrays, and string ABI edge cases.

[Project]
Name    = "test_adversarial"
Type    = "Executable"
Version = "1.0.0"

[Target]
Arch = "x86_64-unknown-none-elf"

[Output]
OutDir  = "build"
OutFile = "test_adversarial.elf"

[Entry]
EntryPoint = "_start"

[Linker]
LinkerScript = "user_linker.ld"
Libraries    = [
    "../../lib/pros/build/libpros.a"
]

[Sources]
Assembly = "../../lib/runtime/brt0.S"
Assembly = "../../lib/runtime/mem.S"
Module   = "src/AdversarialMain.bas"

