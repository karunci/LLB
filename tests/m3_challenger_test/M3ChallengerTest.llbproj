' Project Name: Low-Level Basic / M3 Adversarial Challenger Test Suite
' Filename: tests/m3_challenger_test/M3ChallengerTest.llbproj
' Summary: Manifest for empirical adversarial verification of Milestone 3 service cast cleanups and implicit widening.

[Project]
Name    = "M3ChallengerTest"
Type    = "Executable"
Version = "1.0.0"

[Output]
OutDir  = "build"
OutFile = "m3_challenger_test"

[Entry]
EntryPoint = "M3ChallengerMain.Main"

[Sources]
Module = "src/M3ChallengerMain.bas"

[CompilerOptions]
Optimize            = "O0"
EmitDebugSymbols    = True
AllowUnsafePointers = True

